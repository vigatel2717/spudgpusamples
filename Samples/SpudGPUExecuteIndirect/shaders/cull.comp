#version 450

// Must match TRIANGLE_COUNT/TRIANGLE_HALF_WIDTH/TRIANGLE_DEPTH/CULL_OFFSET in
// ../main.c and local_size_x below matching COMPUTE_THREAD_BLOCK_SIZE there --
// all four are genuinely compile-time constants in the original D3D12 sample
// too (never updated at runtime), so they're baked in here rather than
// plumbed through push constants, which spudgpu_cmd_push_constants doesn't
// support for compute pipelines yet (see ../../../README.md).
layout(local_size_x = 128) in;

const uint TRIANGLE_COUNT = 256;
const float TRIANGLE_HALF_WIDTH = 0.05;
const float TRIANGLE_DEPTH = 1.0;
const float CULL_OFFSET = 0.5;

struct SceneConstantBuffer {
	vec4 velocity;
	vec4 offset;
	vec4 color;
};

struct IndirectCommand {
	uint vertex_count;
	uint instance_count;
	uint first_vertex;
	uint first_instance;
};

layout(set = 0, binding = 0) uniform SceneBuffer {
	SceneConstantBuffer triangles[TRIANGLE_COUNT];
} scene;

layout(set = 0, binding = 1) uniform InputCommands {
	IndirectCommand commands[TRIANGLE_COUNT];
} input_commands;

layout(set = 0, binding = 2) buffer OutputCommands {
	IndirectCommand commands[TRIANGLE_COUNT];
} output_commands;

layout(set = 0, binding = 3) uniform ProjectionBuffer {
	mat4 projection;
} proj;

void main() {
	uint index = gl_GlobalInvocationID.x;
	if (index >= TRIANGLE_COUNT)
		return;

	vec4 offset = scene.triangles[index].offset;

	// Project the triangle's left and right extent into clip space, same
	// test as the original compute.hlsl -- only draw triangles whose
	// projected span still overlaps [-CULL_OFFSET, CULL_OFFSET].
	vec4 left = proj.projection * (vec4(-TRIANGLE_HALF_WIDTH, 0.0, TRIANGLE_DEPTH, 1.0) + offset);
	left /= left.w;

	vec4 right = proj.projection * (vec4(TRIANGLE_HALF_WIDTH, 0.0, TRIANGLE_DEPTH, 1.0) + offset);
	right /= right.w;

	bool visible = (-CULL_OFFSET < right.x) && (left.x < CULL_OFFSET);

	IndirectCommand cmd = input_commands.commands[index];
	if (!visible)
		cmd.vertex_count = 0;

	output_commands.commands[index] = cmd;
}
