#version 450
#extension GL_EXT_mesh_shader : require

// 128/64/126 match the meshlet generator's limits used across the whole
// D3D12MeshShaders sample family (see ../../../README.md) - not a SpudGPU
// constraint.
layout(local_size_x = 128) in;
layout(triangles, max_vertices = 64, max_primitives = 126) out;

struct Meshlet {
	uint vert_count;
	uint vert_offset;
	uint prim_count;
	uint prim_offset;
};

// Deliberately NOT `struct Vertex { vec3 position; vec3 normal; }` -- in both
// std140 and std430, a vec3 struct member has a 16-byte base alignment (same
// as vec4), so the compiler places `normal` at byte offset 16 and rounds the
// whole struct up to 32 bytes. The file's actual data (and the host upload in
// main.c) is genuinely tightly packed at 24 bytes/vertex (2x vec3, no
// padding), so a vec3-struct buffer here silently reads every vertex past
// index 0 from the wrong byte offset. A flat scalar array sidesteps this:
// std430 (unlike std140) does NOT round an array-of-scalars' stride up to 16
// bytes, so `float data[]` is genuinely 4-byte-strided and lets
// get_vertex_position/normal below compute the real 24-byte-per-vertex
// offsets by hand.
layout(set = 0, binding = 0) readonly buffer VerticesBuf { float data[]; } vertices;
layout(set = 0, binding = 1) readonly buffer MeshletsBuf { Meshlet data[]; } meshlets;
// Packed 16- or 32-bit vertex indices, always read as whole aligned uint32
// words (see get_vertex_index) - matches the original's ByteAddressBuffer
// usage exactly (every byte offset it computes is a multiple of 4).
layout(set = 0, binding = 2) readonly buffer UniqueVertexIndicesBuf { uint data[]; } unique_vertex_indices;
// One packed 10:10:10 triangle per element.
layout(set = 0, binding = 3) readonly buffer PrimitiveIndicesBuf { uint data[]; } primitive_indices;

layout(set = 1, binding = 0) uniform Globals {
	mat4 world;
	mat4 world_view;
	mat4 world_view_proj;
	uint draw_meshlets;
} globals;

layout(push_constant) uniform PushConstants {
	uint index_bytes;
	uint meshlet_offset;
} pc;

layout(location = 0) out vec3 out_position_vs[];
layout(location = 1) out vec3 out_normal[];
layout(location = 2) out flat uint out_meshlet_index[];

uvec3 unpack_primitive(uint primitive) {
	return uvec3(primitive & 0x3FFu, (primitive >> 10) & 0x3FFu, (primitive >> 20) & 0x3FFu);
}

uvec3 get_primitive(Meshlet m, uint index) {
	return unpack_primitive(primitive_indices.data[m.prim_offset + index]);
}

vec3 get_vertex_position(uint vertex_index) {
	uint base = vertex_index * 6u;
	return vec3(vertices.data[base + 0u], vertices.data[base + 1u], vertices.data[base + 2u]);
}

vec3 get_vertex_normal(uint vertex_index) {
	uint base = vertex_index * 6u;
	return vec3(vertices.data[base + 3u], vertices.data[base + 4u], vertices.data[base + 5u]);
}

uint get_vertex_index(Meshlet m, uint local_index) {
	local_index = m.vert_offset + local_index;

	if (pc.index_bytes == 4u) {
		return unique_vertex_indices.data[local_index];
	} else {
		uint word_offset = local_index & 1u;
		uint dword_index = local_index / 2u;
		uint index_pair = unique_vertex_indices.data[dword_index];
		return (index_pair >> (word_offset * 16u)) & 0xFFFFu;
	}
}

void main() {
	uint gid = gl_WorkGroupID.x;
	uint gtid = gl_LocalInvocationIndex;

	Meshlet m = meshlets.data[pc.meshlet_offset + gid];

	SetMeshOutputsEXT(m.vert_count, m.prim_count);

	if (gtid < m.prim_count) {
		gl_PrimitiveTriangleIndicesEXT[gtid] = get_primitive(m, gtid);
	}

	if (gtid < m.vert_count) {
		uint vertex_index = get_vertex_index(m, gtid);
		vec3 position = get_vertex_position(vertex_index);
		vec3 normal   = get_vertex_normal(vertex_index);

		vec4 pos_vs = globals.world_view * vec4(position, 1.0);
		vec4 pos_hs = globals.world_view_proj * vec4(position, 1.0);

		gl_MeshVerticesEXT[gtid].gl_Position = pos_hs;
		out_position_vs[gtid] = pos_vs.xyz;
		out_normal[gtid] = (globals.world * vec4(normal, 0.0)).xyz;
		out_meshlet_index[gtid] = gid;
	}
}
